# Copy this file to .env in the same directory and fill in real values.
# .env itself is gitignored - it never gets committed. This file is the template that DOES get
# committed, so anyone cloning the repo (or deploying to Vercel) knows exactly what to set.

# --- API base URL --------------------------------------------------------------
# Leave blank for local dev: requests go to the relative path /api/v1, which Vite's own dev
# server proxies to http://localhost:8000 (see vite.config.js) - this only works with `npm run
# dev`, never in a production build. Once deployed (Vercel or anywhere else), THIS MUST be set
# to your backend's real, publicly reachable URL, e.g. https://your-api.onrender.com/api/v1 -
# there is no dev proxy in production, so a blank value here means every API call 404s.
VITE_API_BASE_URL=

# --- Supabase Auth (optional) ---------------------------------------------------
# Leave both blank to skip auditor login entirely (matches the backend's soft-gate default -
# every request is treated as a local-dev registry_admin). Fill in from your Supabase project's
# Settings -> API page to require real sign-in. Must be the SAME project as the backend's
# SUPABASE_URL/SUPABASE_JWT_SECRET.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
