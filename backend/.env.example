# Copy this file to .env in the same directory and fill in real values.
# .env itself is gitignored - it never gets committed. This file is the template that DOES get
# committed, so anyone cloning the repo on any machine knows exactly what to configure. Never
# put real secrets in this file.

# --- Database ---------------------------------------------------------------
# SQLite (zero setup, fine for local dev/demo - creates backend/recshield.db):
DATABASE_URL=sqlite:///./recshield.db
# Postgres (needed for a real deployment - Supabase's own Postgres works too):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/recshield

# --- CORS ---------------------------------------------------------------------
# JSON list of extra frontend origins to allow, beyond the built-in localhost/LAN regex
# (see app/main.py) which already covers any local dev port. Add your deployed frontend's
# real origin here once you deploy it, e.g. ["https://your-app.vercel.app"].
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM explanations (optional) ---------------------------------------------
# Without this, verification explanations fall back to a deterministic template - the app
# works fine either way.
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# --- Public verification links ------------------------------------------------
# Where a PDF audit report's embedded verification link points. Must be the frontend's real
# origin in production (e.g. https://your-app.vercel.app) or downloaded reports will print a
# localhost link nobody else can open.
PUBLIC_BASE_URL=http://localhost:5173

# --- Supabase Auth (optional) -------------------------------------------------
# Leave both blank to skip auth entirely: every request is treated as a local-dev
# registry_admin (matches pytest's assumption and lets you run the app with zero external
# services). Fill in ONE of these (not both need to be set) to require real sign-in - use the
# same Supabase project as the frontend's VITE_SUPABASE_URL.
#   SUPABASE_JWT_SECRET: Project Settings -> API -> JWT Settings -> "Legacy JWT Secret"
#   SUPABASE_URL: the project URL - verifies tokens via the project's public JWKS instead
SUPABASE_JWT_SECRET=
SUPABASE_URL=
